{
  "name": "senderx",
  "version": "1.0.0",
  "private": true,
  "description": "SenderX - Cold email hiper-personalizado con IA. Motor SMTP/IMAP con throttle 40s, auto-backup safety net, cross-campaign duplicate detection.",
  "scripts": {
    "dev": "next dev -p 3000",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "db:push": "tsx scripts/safe-push.ts",
    "db:safe-push": "tsx scripts/safe-push.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "echo 'PELIGRO: db:reset borra TODA la base. Si realmente quieres hacerlo, ejecuta directamente: npx prisma migrate reset' && exit 1",
    "db:backup": "tsx scripts/backup-data.ts",
    "db:restore": "tsx scripts/restore-data.ts"
  },
